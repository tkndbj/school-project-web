# Copy to .env.local and fill in. Never commit real values.
# Local Supabase (`npx supabase start`) prints these values; for a hosted project
# use Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Full database access: keep it out of the browser and out of git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional, local tooling only: direct/session-pooler URL for schema migrations.
# Never prefix this with NEXT_PUBLIC_ or include it in mobile configuration.
# SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Used by `supabase start` for the Google provider (supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Development by default; Vercel sets the production/staging mode automatically.
APP_ENV=development
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Test data is explicit and must never be enabled on the production project.
ALLOW_TEST_FIXTURES=false
# Optional database certificate for operator tooling.
# SUPABASE_DB_CA_FILE=.supabase-ca.crt
